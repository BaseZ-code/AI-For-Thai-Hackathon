# ChaiToke Environment Configuration
# Copy this file to .env and fill in the values.

# ThaiLLM
THAILLM_API_KEY=your-api-key-here
THAILLM_BASE_URL=https://api.thaillm.example.com
THAILLM_MODEL=thaillm-v1
THAILLM_TIMEOUT_SECONDS=30

# App
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT=60/minute
